generator client {
  provider   = "prisma-client"
  output     = "../lib/generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

model account {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime
  user                  user      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model post {
  post_id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  post_data        DateTime           @default(now()) @db.Timestamptz(6)
  post_img_url     String?            @db.VarChar(512)
  post_titulo      String             @db.VarChar(300)
  post_conteudo    String             @db.VarChar(5000)
  post_ncurtidas   Int                @default(0)
  user_id          String             @db.Uuid
  user             user               @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_post_usuario")
  post_comentarios post_comentarios[]
  postCurtidas     post_curtidas[]

  @@index([user_id], map: "idx_post_usuario")
}

model post_curtidas {
  post_id String @db.Uuid
  user_id String @db.Uuid
  post    post   @relation(fields: [post_id], references: [post_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_curtida_post")
  user    user   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_curtida_usuario")

  @@id([post_id, user_id])
}

model post_comentarios {
  comentario_id String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  post_id       String    @db.Uuid
  user_id       String    @db.Uuid
  comentario    String    @db.VarChar(5000)
  criado_em     DateTime? @default(now()) @db.Timestamptz(6)
  post          post      @relation(fields: [post_id], references: [post_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_comentario_post")
  user          user      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_comentario_usuario")

  @@index([post_id], map: "idx_comentarios_post")
  @@index([user_id], map: "idx_comentarios_usuario")
}

model session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model user {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String             @db.VarChar(100)
  email               String             @unique @db.VarChar(100)
  emailVerified       Boolean            @default(false)
  image               String?            @db.VarChar(512)
  createdAt           DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime           @db.Timestamptz(6)
  user_datanascimento DateTime           @db.Date
  user_apelido        String             @unique @db.VarChar(100)
  user_bio            String?            @db.VarChar(300)
  user_genero         String?            @db.VarChar(20)
  user_fone           String?            @unique @db.VarChar(18)
  user_nseguidores    Int                @default(0)
  user_nseguindo      Int                @default(0)
  account             account[]
  post                post[]
  post_comentarios    post_comentarios[]
  session             session[]
  postCurtidas        post_curtidas[]
}

model verification {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime

  @@index([identifier])
}
